rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function hasUidProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasEmailProfile() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }
    function role() {
      return hasUidProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (hasEmailProfile()
          ? get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role
          : null);
    }
    function isOwner() { return signedIn() && (role() == 'owner' || role() == 'OWNER'); }
    function isAdmin() { return signedIn() && (role() == 'admin' || role() == 'ADMIN'); }
    function isKasir() { return signedIn() && (role() == 'kasir' || role() == 'KASIR'); }
    function isKurir() { return signedIn() && role() == 'KURIR'; }
    function isStaff() { return isOwner() || isAdmin() || isKasir() || isKurir(); }

    match /users/{userId} {
      allow read: if signedIn() && (
        userId == request.auth.uid ||
        (request.auth.token.email != null && userId == request.auth.token.email) ||
        isOwner() || isAdmin()
      );
      // Admin/Kasir bootstrap: the application creates its own UID profile after
      // validating the local/cloud staff account. This is required because the
      // current Admin/Kasir login uses Firebase Anonymous Authentication.
      allow create: if signedIn() && (
        userId == request.auth.uid || isOwner() || isAdmin()
      );
      allow update: if signedIn() && (
        userId == request.auth.uid || isOwner() || isAdmin()
      );
      allow delete: if isOwner();
    }

    match /orders/{orderId} {
      // Owner/Admin/Kasir can see all online orders. Customers can see only their
      // own orders. Couriers retain the existing courier workflow.
      allow read: if isOwner() || isAdmin() || isKasir()
        || (isKurir() && (
          resource.data.status == 'BARU' || resource.data.courierUid == request.auth.uid
        ))
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      // Customer creates a new order. kasirStatus is required for the current
      // customer-v2 flow; the old fallback is handled by the staff page.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'BARU'
        && request.resource.data.kasirStatus == 'BARU';

      // Admin/Kasir may accept, dispatch and complete online orders.
      allow update, delete: if isOwner() || isAdmin() || isKasir();

      // Existing courier workflow remains available.
      allow update: if isKurir() && (
        (resource.data.status == 'BARU' &&
         resource.data.courierUid == null &&
         request.resource.data.status == 'DIPROSES' &&
         request.resource.data.courierUid == request.auth.uid) ||
        (resource.data.courierUid == request.auth.uid &&
         request.resource.data.courierUid == request.auth.uid &&
         request.resource.data.customerUid == resource.data.customerUid &&
         ((resource.data.status == 'DIPROSES' && request.resource.data.status == 'DIANTAR') ||
          (resource.data.status == 'DIANTAR' && request.resource.data.status == 'SELESAI')))
      );

      // Customer may rate a completed courier order once.
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'SELESAI'
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.courierUid == resource.data.courierUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.courierRating is int
        && request.resource.data.courierRating >= 1
        && request.resource.data.courierRating <= 5
        && !('courierRating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'courierRating','courierReview','courierRatedAt'
        ]);
    }

    match /activity/{activityId} {
      allow create: if isStaff() || (
        signedIn() && request.resource.data.type == 'ORDER_NEW' &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.role == 'PELANGGAN'
      );
      allow read: if isOwner() || isAdmin();
      allow update, delete: if isOwner();
    }

    // Existing app_data remains available to signed-in application users.
    match /app_data/{document=**} {
      allow read, write: if signedIn();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
